# .vscodeignore
#
# Mirrors .gitignore: any pattern here that also appears in .gitignore exists
# because the file is a local artifact that must never reach a user. The one
# deliberate departure is the build-output section at the top — `out/` and
# `webviews/dist/` are gitignored precisely because they are generated, but the
# extension cannot run without them, so they are re-included explicitly rather
# than simply left unmentioned.
#
# Order matters: later patterns win.

# Build artifacts
#
# IGNORED BY GIT, SHIPPED IN THE VSIX. These two lines cancel each other out on
# purpose — the un-ignore is what actually keeps the bundle alive in the package.
out/**
!out/**

# Dependencies
node_modules/**
**/node_modules/**
.pnpm-store/

# Packaged extension bundles
*.vsix
*.vsixmanifest

# esbuild / vite intermediates
.esbuild/
.vite/
*.tsbuildinfo
**/*.map

# Coverage & profiling output
coverage/
.nyc_output/
*.lcov

# Rust
target/

# Python bytecode from the src/py and src/scripts bridges
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE specific
.vscode/**
.vscode-test/**
.idea/**
.history/**
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.code-workspace

# OS specific
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# Local configuration & secrets
**/.env*
.npmrc

# Project specific
#
# The maintainer's own translation workspace. The extension resolves
# `localized_data/` from the opened workspace folder, never from extensionPath,
# so shipping a copy would only confuse users.
localized_data/**

# pnpm workspace files generated by `pnpm approve-builds` prompts
pnpm-workspace.yaml
**/pnpm-workspace.yaml

# Source and dev tooling — the compiled bundles in out/ and webviews/dist/
# replace all of this at runtime.
src/**
webviews/**
!webviews/dist/**
!webviews/dist/**/*
scripts/**
docs/**
externals/**
**/*.ts
**/*.svelte
tsconfig.json
eslint.config.mjs
build.mjs
node-pre-gyp.js
pnpm-lock.yaml
vsc-extension-quickstart.md

# Repo metadata that has no business shipping to users
.github/**

# AI / LLM coding agent state (same list as .gitignore)
.freebuff/
.gemini/
.claude/
.claude.json
CLAUDE.md
.codex/
.cursor/
.cursorignore
.github/copilot-instructions.md
.aider*
.aider.chat.history.md
.cline/
.windsurf/
.windsurfrules
.continue/
.zed/
.jetbrains/
.aws/
.codewhisperer/
.tabnine/
.cody/
.void/
.agent/
.agents/
.ai/
.llm/
.agentignore
.aiignore
